component Menu(
    param background_path {"Assets/Backgrounds/MainMenu.png"}
    param font_style {"Game"}
    param char_dim {32}

    component Row(
        param row_number {0}
        param starting_y {150}

        component Button(
            param starting_x {150}
            param text {"NEW GAME"}
            param function {"START_NEW_GAME"}
            param id {"button_for_starting_new_game"}
        )       
    )

    component Row(
        param row_number {1}
        param starting_y {194}

        component Button(
            param starting_x {150}
            param text {"CONTINUE"}
            param function {"START_GAME"}
            param id {"button_for_starting_game"}
        )
    )

    component Row(
        param row_number {2}
        param starting_y {238}

        component Button(
            param starting_x {150}
            param text {"EDITOR"}
            param function {"OPEN_EDITOR_MENU"}
            param id {"button_for_opening_editor_menu"}
        )
    )

    component Row(
        param row_number {3}
        param starting_y {282}

        component Button(
            param starting_x {150}
            param text {"SETTINGS"}
            param function {"OPEN_GENERAL_SETTINGS_MENU"}
            param id {"button_for_opening_settings_menu"}
        )
    )

    component Row(
        param row_number {4}
        param starting_y {326}

        component Button(
            param starting_x {150}
            param text {"EXIT"}
            param function {"EXIT_GAME"}
            param id {"button_for_exiting_the_game"}
        )
    )
)