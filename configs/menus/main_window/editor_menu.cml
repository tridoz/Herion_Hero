component Menu(
    param background_path {"Assets/Backgrounds/Black.png"}
    param button_y_offset {12}
    param center_piece_offset {8}
    param font_style {"Game"}
    param char_dim {32}

    component Row(
        param row_number {0}
        param starting_y {150}
        
        component Button(
            param starting_x {150}
            param text {"LEVELS"}
            param function {"OPEN_LEVEL_EDITOR"}
            param id {"button_for_opening_level_editor"}
        )
    )

    component Row (
        param row_number {1}
        param starting_y {194}
        
        component Button(
            param starting_x {150}
            param text {"ANIMATIONS"}
            param function {"OPEN_ANIMATION_EDITOR"}
            param id {"button_for_opening_animation_editor"}
        )
    )

    component Row (
        param row_number {2}
        param starting_y {238}

        component Button(
            param starting_x {150}
            param text {"MENUS"}
            param function {"OPEN_MAIN_MENU"}
            param id {"button_for_opening_menu_editor"}
        )
    )

    component Row (
        param row_number {3}
        param starting_y {282}

        component Button(
            param starting_x {150}
            param text {"BACK"}
            param function {"OPEN_MAIN_MENU"}
            param id {"button_return_previous_game_mode"}
        )
    )
)