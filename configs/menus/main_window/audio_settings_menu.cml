component Menu(
    param backgorund_path {"Assets/Backgrounds/Black.png"};
    param start_y {150};
    param button_y_offset {12};
    param center_piece_offset {8};
    param menu_type {"button_menu"};
    param button_style {"Game"};
    param font_style {"Game"};
    param char_width {32.0};

    component Row(
        param starting_x {150};
        param button_x_offset {50};
        component StaticText(
            param text {"MASTER VOLUME"},
            param id {"static_text_displayy_master_volume_label"}
        );
    );

    component Row(
        param starting_x {150};
        param button_x_offset {150};
        component SliderSelector(
            param max_value {100},
            param min_value {0},
            param step {1},
            param slider_bar_offset {30},
            param length {500},
            param id {"slider_selector_for_master_volume"},
            param action {"SETTER"},
            param value_to_set {"MASTER_VOLUME"}
        );

        component DynamicText(
            param reference {MASTER_VOLUME},
            param id {"dynamic_text_master_volume_value"}
        );
    );

    component Row(
        param starting_x {150};
        param button_x_offset {150};
        component SliderSelector(
            param max_value {100},
            param min_value {0},
            param step {1},
            param slider_bar_offset {30},
            param length {500},
            param id {"slider_selector_for_music_volume"},
            param action {"SETTER"},
            param value_to_set {"MUSIC_VOLUME"}
        );

        component DynamicText(
            param reference {MASTER_VOLUME},
            param id {"dynamic_text_music_volume_value"}
        );
    );

    component Row(
        param starting_x {150};
        param button_x_offset {150};
        component SliderSelector(
            param max_value {100},
            param min_value {0},
            param step {1},
            param slider_bar_offset {30},
            param length {500},
            param id {"slider_selector_for_sfx_volume"},
            param action {"SETTER"},
            param value_to_set {"SFX_VOLUME"}
        );

        component DynamicText(
            param reference {MASTER_VOLUME},
            param id {"dynamic_text_sfx_volume_value"}
        );
    );

    component Row(
        param starting_x {150};
        param button_x_offset {0};
        component Button(
            param text {"DONE"},
            param function {"ButtonFunctions::ReturnPreviousState"},
            param id {"button_return_previous_game_mode"}
        );
    );

);
